{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet list package *)",
      "Bash(flutter pub get *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(dart format *)",
      "Bash(dart run build_runner *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "PowerShell(dotnet restore *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet format *)",
      "PowerShell(dotnet list package *)",
      "PowerShell(flutter pub get *)",
      "PowerShell(flutter analyze *)",
      "PowerShell(flutter test *)",
      "PowerShell(dart format *)",
      "PowerShell(dart run build_runner *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test *)",
      "Bash(dotnet run *)",
      "Bash(dotnet ef migrations *)",
      "Bash(dotnet clean *)",
      "Bash(flutter pub *)",
      "Bash(flutter build *)",
      "Bash(flutter clean)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npx nx *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(rm -rf chantier-frontend/node_modules)",
      "Bash(rm -rf chantier-frontend/dist)",
      "Bash(rm -rf chantier-frontend/.nx)",
      "Bash(rm -rf chantier-frontend/coverage)",
      "Bash(rm -rf chantier-mobile/build)",
      "Bash(rm -rf chantier-mobile/.dart_tool)",
      "Bash(rm -rf chantier-backend/TestResults)",
      "Bash(rm -rf .dev)",
      "PowerShell(dotnet run *)",
      "PowerShell(dotnet ef migrations *)",
      "PowerShell(dotnet clean *)",
      "PowerShell(flutter pub *)",
      "PowerShell(flutter build *)",
      "PowerShell(flutter clean)",
      "PowerShell(npm ci *)",
      "PowerShell(npm install *)",
      "PowerShell(npx nx *)",
      "PowerShell(docker compose *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(.\\scripts\\dev.ps1 *)",
      "PowerShell(Remove-Item -Recurse -Force chantier-frontend\\node_modules)",
      "PowerShell(Remove-Item -Recurse -Force chantier-frontend\\dist)",
      "PowerShell(Remove-Item -Recurse -Force chantier-mobile\\build)",
      "PowerShell(Remove-Item -Recurse -Force chantier-mobile\\.dart_tool)",
      "PowerShell(Remove-Item -Recurse -Force .dev)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(dotnet ef database *)",
      "PowerShell(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(dotnet ef database *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/key.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)"
    ]
  }
}
