{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ChantierDb": ""
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "chantier-api",
    "Audience": "chantier-clients",
    "AccessTokenDurationInMinutes": 15,
    "RefreshTokenDurationInDays": 14
  },
  "Cors": {
    "Origins": []
  },
  "Materials": {
    "DefaultNeededByDays": 3,
    "DeliveryTolerancePercent": 0,
    "MaxPhotosPerDelivery": 5,
    "NoteMaxLength": 200,
    "DeliveryNoteMaxLength": 30,
    "FreeNameMinLength": 3,
    "FreeNameMaxLength": 100
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowMinutes": 5 },
    "Global": { "PermitLimit": 300, "WindowMinutes": 1 }
  }
}
