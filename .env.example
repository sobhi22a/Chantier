# Copier vers .env (ignore par git) puis remplacer les valeurs. Ne jamais committer .env.
# scripts/dev.ps1 cree .env avec un mot de passe aleatoire s'il n'existe pas.

# Mot de passe de l'administrateur SA du SQL Server de developpement.
# Regle SQL Server : 8 caracteres minimum, 3 categories parmi majuscule, minuscule, chiffre, symbole.
MSSQL_SA_PASSWORD=<a-definir-localement>

# Port hote -> 1433 du conteneur (ADR 0003, plan socle)
MSSQL_PORT=14335

# Memoire maximale du conteneur SQL Server (Mo) ; 2048 suffit au socle
MSSQL_MEMORY_LIMIT_MB=2048
