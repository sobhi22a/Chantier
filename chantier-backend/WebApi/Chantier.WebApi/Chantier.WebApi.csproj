<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>chantier-webapi</UserSecretsId>
    <!-- Les commentaires XML alimentent les resumes et descriptions du document OpenAPI ; CS1591 (commentaire manquant) n'est pas exige. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!--
    Contrat d'API : le document OpenAPI genere fait foi et est commite dans docs/api/openapi.json (ADR 0006).
    Il est ecrit a chaque build ; la CI regenere puis echoue si `git diff` n'est pas vide.
    Sans effet de bord : pas de base ni de secret pendant la generation (voir OpenApiGeneration).
  -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../docs/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Chantier.Core\Chantier.Core.csproj" />
    <ProjectReference Include="..\..\Core\Chantier.Infrastructure\Chantier.Infrastructure.csproj" />
  </ItemGroup>

</Project>
